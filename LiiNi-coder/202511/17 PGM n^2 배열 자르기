class Solution {
    public int[] solution(int n, long left, long right) {
        long size = right - left + 1;
        int[] answer = new int[(int)size];
        for(int i = 0; i < size; i++){
            long index = left + i;
            long row = index / n;
            long col = index % n;
            answer[i] = (int)(Math.max(row, col) + 1);
            
            // System.out.println(index + " " + row + " " + col);
        }
        return answer;
    }
}

