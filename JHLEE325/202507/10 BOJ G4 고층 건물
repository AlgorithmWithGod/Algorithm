        int max = 0;
        for (int i = 0; i < n; i++) {
            double temp = 1000000001;
            int count = 0;
            for (int j = i - 1; j >= 0; j--) {
                double degree = (double) (buildings[i] - buildings[j]) / (i - j);
                if (temp > degree) {
                    count++;
                    temp = degree;
                } else {
                    continue;
                }
            }
            temp = -1000000001;
            for (int j = i + 1; j < n; j++) {
                double degree = (double) (buildings[j] - buildings[i]) / (j - i);
                if (temp < degree) {
                    count++;
                    temp = degree;
                } else {
                    continue;
                }
            }
            max = Math.max(max, count);
        }

        System.out.println(max);
    }
}
