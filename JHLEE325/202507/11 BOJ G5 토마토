                    box[i][j][height] = Integer.parseInt(st.nextToken());
                    if (box[i][j][height] == 0) count++;
                    if (box[i][j][height] == 1) list.add(new int[]{i, j, height});
                }
            }
        }

        tomato();

        if (count == 0)
            System.out.println(day);
        else System.out.println("-1");
    }

    static void tomato() {
        while (!list.isEmpty()) {
            int s = list.size();
            for (int i = 0; i < s; i++) {
                int[] cur = list.poll();
                int y = cur[0];
                int x = cur[1];
                int he = cur[2];

                for (int d = 0; d < 6; d++) {
